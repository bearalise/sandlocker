{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus" }
  ],
  "title": "SandLocker — 只读监控看板 (M3 W8, D6/M3-Q12)",
  "uid": "sandlocker-overview",
  "tags": ["sandlocker", "read-only"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "当前存活沙箱数",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "sandlocker_sandboxes_current", "refId": "A" } ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "池命中率",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        {
          "expr": "sum(rate(sandlocker_pool_hits_total[5m])) / clamp_min(sum(rate(sandlocker_pool_hits_total[5m]) + rate(sandlocker_pool_misses_total[5m])), 1)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "API 错误率 (5m)",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        {
          "expr": "sum(rate(sandlocker_api_errors_total[5m])) / clamp_min(sum(rate(sandlocker_api_requests_total[5m])), 1)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "创建/销毁累计",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sandlocker_sandboxes_created_total", "refId": "A", "legendFormat": "created" },
        { "expr": "sandlocker_sandboxes_destroyed_total", "refId": "B", "legendFormat": "destroyed" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "沙箱创建延迟分位 (P50/P90/P99, ms)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(sandlocker_create_latency_ms_bucket[5m])) by (le))", "refId": "A", "legendFormat": "P50" },
        { "expr": "histogram_quantile(0.90, sum(rate(sandlocker_create_latency_ms_bucket[5m])) by (le))", "refId": "B", "legendFormat": "P90" },
        { "expr": "histogram_quantile(0.99, sum(rate(sandlocker_create_latency_ms_bucket[5m])) by (le))", "refId": "C", "legendFormat": "P99" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "exec 延迟分位 (P50/P99, ms)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(sandlocker_exec_latency_ms_bucket[5m])) by (le))", "refId": "A", "legendFormat": "P50" },
        { "expr": "histogram_quantile(0.99, sum(rate(sandlocker_exec_latency_ms_bucket[5m])) by (le))", "refId": "B", "legendFormat": "P99" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "API 请求 / 错误速率 (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        { "expr": "sum(rate(sandlocker_api_requests_total[5m]))", "refId": "A", "legendFormat": "requests" },
        { "expr": "sum(rate(sandlocker_api_errors_total[5m]))", "refId": "B", "legendFormat": "errors" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "创建速率 (create/s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        { "expr": "sum(rate(sandlocker_sandboxes_created_total[5m]))", "refId": "A", "legendFormat": "created/s" }
      ]
    }
  ]
}
