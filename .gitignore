# Rust
target/

# Go
/bin/
*.test
*.out

# 构建产物（rootfs/内核/快照等本地工件）
/build/
dist/
**/dist-test
node_modules/
# mdBook 文档站构建产物（book.toml src=docs → 输出 ./book）
/book/
*.img
*.ext4
*.log
# 例外：裸金属取证的运行日志是**证据**，不是构建产物——机器毁掉就再也拿不到（见
# docs/design/M3-Q9裸金属取证-*.md）。
!docs/design/*取证*.log

# 本地免 sudo 构建工具链（scripts/build-kernel.sh 回退用）
/.toolchain/

# 编辑器与系统
.idea/
.vscode/
*.swp
.DS_Store

# Python（SDK / 场景脚本产物）
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/lib/
.pytest_cache/

# 密钥
.env
.env.*
# npm 发布凭证（token 只应放家目录级 ~/.npmrc，仓库内一律不入库）
.npmrc
**/.npmrc
