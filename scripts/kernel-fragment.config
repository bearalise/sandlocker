# SandLocker guest 内核增量配置（叠加在 Firecracker 基线之上）
# 依据：ADR-12（vmgenid reseed）、ADR-4（vsock）、ADR-18（envd init）、ADR-23（dm-thin，M1）

# ADR-12：恢复快照时内核自动 reseed CRNG（需 ≥5.18）
CONFIG_VMGENID=y

# ADR-4：host↔guest 通信
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS_COMMON=y

# virtio-mmio（Firecracker 设备模型）
# 注意：不要开 CMDLINE_DEVICES——FC v1.16 经 ACPI(FIRECK DSDT) 枚举 virtio 设备，
# 基线亦故意关闭它；开启会按 cmdline 的 virtio_mmio.device= 重复注册，得 EBUSY 影子设备。
CONFIG_VIRTIO_MMIO=y

# 根文件系统与写层
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_OVERLAY_FS=y

# ADR-23：M1 存储栈（dm thin pool）；CONFIG_MD 是 BLK_DEV_DM 的前置（FC 基线关闭了它）
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_THIN_PROVISIONING=y
